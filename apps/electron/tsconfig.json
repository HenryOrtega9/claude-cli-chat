{
  /*
   * Separate project for the desktop shell so the plugin's typecheck surface
   * (root tsconfig, `include: src/**`) stays exactly as it was. Both are run by
   * `npm run typecheck`. compilerOptions — including baseUrl/paths — are
   * inherited and still resolve against the repo root, so app code importing
   * ../../../src/... or @/... type-checks against the same shared sources.
   */
  "extends": "../../tsconfig.json",
  "include": ["src/**/*.ts"]
}
