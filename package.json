{
  "name": "claude-cli-chat",
  "version": "0.1.0",
  "description": "Claudian-style chat UI for Claude Code CLI, packaged as an Obsidian plugin.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "node esbuild.config.mjs",
    "build:app": "node esbuild.config.mjs --app",
    "build:app:prod": "node esbuild.config.mjs --app --production",
    "build:ios": "node esbuild.config.mjs --ios",
    "build:ios:prod": "node esbuild.config.mjs --ios --production",
    "dev:ios": "node esbuild.config.mjs --ios --watch",
    "dev:app": "node esbuild.config.mjs --app --watch",
    "start:app": "npm run build:app && electron app/dist/main.js",
    "package:app": "npm run build:app:prod && electron-builder --mac dir --config electron-builder.yml",
    "typecheck": "tsc --noEmit && tsc --noEmit -p app/tsconfig.json && tsc --noEmit -p ios-web/tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "builtin-modules": "^4.0.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.24.0",
    "obsidian": "^1.7.2",
    "tslib": "^2.6.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "lucide": "^1.31.0",
    "mammoth": "^1.12.0",
    "marked": "^18.0.9"
  }
}
